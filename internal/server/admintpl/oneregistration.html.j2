<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <title>Registrations</title>
    <!-- AdminLTE 4 + Bootstrap 5.3 (CSS) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/css/adminlte.min.css" />

    <!-- Bootstrap + Popper + AdminLTE (JS) -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>
    <script
        src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/js/adminlte.min.js"></script>

    <link href="https://unpkg.com/tabulator-tables@6.5.0/dist/css/tabulator.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"></script>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- Header -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-primary" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="#" class="brand-link">
                    <span class="brand-text fw-light">Onboarding</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                        <li class="nav-item">
                            <a href="/admin/registrations" class="nav-link active">
                                <i class="nav-icon bi bi-speedometer"></i>
                                <p>Registrations</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/organizations" class="nav-link">
                                <i class="nav-icon bi bi-bar-chart"></i>
                                <p>Organizations</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <h3 class="mb-0"><span>
                            {% if Reg.Role == "Buyer" %}<i class="bi bi-cart-fill"></i>
                            {% else %}<i class="bi bi-shop"></i>{% endif %}
                            {{Reg.CompanyName}} ({{Reg.VatID}})</span>
                    </h3>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">

                    <div class="row">

                        <div class="col">
                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Company profile
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.CompanyName}}</p>
                                            <p class="h5">Address</p>
                                            <p class="card-text">{{Reg.StreetAddress}}, {{Reg.PostalCode }} -
                                                {{Reg.City}} -
                                                {{Reg.Country}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">VAT ID</p>
                                            <p class="card-text">{{Reg.VatID}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Person registering
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.FirstName}} {{Reg.LastName}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.Email}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Legal Representative
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.LRFirstName}} {{Reg.LRLastName}}</p>
                                            <p class="h5">Nationality</p>
                                            <p class="card-text">{{Reg.LRCountry}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.LREmail}}</p>
                                            <p class="h5">ID Card</p>
                                            <p class="card-text">{{Reg.LRIdCard}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Account Admin (LEAR)
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.LEARFirstName}} {{Reg.LEARLastName}}</p>
                                            <p class="h5">Nationality</p>
                                            <p class="card-text">{{Reg.LEARCountry}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.LEAREmail}}</p>
                                            <p class="h5">ID Card</p>
                                            <p class="card-text">{{Reg.LEARIdCard}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>


                        </div>

                        <!-- Process Status -->
                        <div class="col-4">

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Process Status
                                </div>
                                <div class="card-body">

                                    <ul class="list-group mb-3">
                                        <li class="list-group-item active" aria-current="true">Stage 1</li>
                                        <li class="list-group-item">
                                            <span
                                                class="badge {{ Reg.Notified|yesno:'text-bg-success,text-bg-danger' }}">
                                                Email Notification
                                            </span>
                                        </li>
                                        <li class="list-group-item">
                                            <span class="badge {{ Reg.Issued|yesno:'text-bg-success,text-bg-danger' }}">
                                                Credential issued
                                            </span>
                                        </li>
                                    </ul>

                                    <ul class="list-group">
                                        <li class="list-group-item active" aria-current="true">Stage 2</li>
                                        <li class="list-group-item">
                                            <span
                                                class="badge {{ Reg.TMFRegistered|yesno:'text-bg-success,text-bg-danger' }}">
                                                Files uploaded
                                            </span>
                                        </li>
                                        <li class="list-group-item">
                                            <span
                                                class="badge {{ Reg.TMFRegistered|yesno:'text-bg-success,text-bg-danger' }}">
                                                Credential to Account Admin
                                            </span>
                                        </li>
                                    </ul>

                                </div>
                            </div>




                        </div>
                    </div>

                    <!-- Activity Log -->
                    <div class="card card-primary card-outline mb-3">
                        <div class="card-header">
                            Activity Log
                        </div>
                        <div class="card-body">
                            <div id="tmf-table"></div>

                        </div>
                    </div>




                </div>
            </div>
        </main>

    </div>

    <script>
        // Initialize Tabulator
        var table = new Tabulator("#tmf-table", {
            ajaxResponse: function (url, params, response) {
                //url - the URL of the request
                //params - the parameters passed with the request
                //response - the JSON object returned in the body of the response.
                return response.data; //return the tableData property of a response json object
            },
            pagination: true,
            paginationSize: 100,
            paginationCounter: "rows",
            paginationCounterElement: "#org-count",
            layout: "fitDataFill",
            columns: [
                {
                    title: "Date", field: "created_at", formatter: function (cell, formatterParams, onRendered) {
                        const data = cell.getData();
                        const createdAt = new Date(data.created_at);
                        var content = `<div>${createdAt.toLocaleDateString("es-ES")}</div>`;
                        return content;
                    }
                },
                { title: "Type", field: "type" },
                { title: "Message", field: "message" }
            ],
            ajaxURL: "/admin/api/registration-log?vat_id={{Reg.VatID}}",

        });
    </script>


</body>

</html>