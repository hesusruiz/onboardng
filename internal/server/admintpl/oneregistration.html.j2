{% include "partials/top.html.j2" with title="Registration" %}

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        {% include "partials/header.html.j2" %}
        {% include "partials/sidebar.html.j2" %}

        <!-- Main content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <h3 class="mb-0"><span>
                            {% if Reg.Role == "Buyer" %}<i class="bi bi-cart-fill"></i>
                            {% else %}<i class="bi bi-shop"></i>{% endif %}
                            {{Reg.CompanyName}} ({{Reg.VatID}})</span>
                    </h3>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">

                    <div class="row">

                        <div class="col">
                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Company profile
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.CompanyName}}</p>
                                            <p class="h5">Address</p>
                                            <p class="card-text">{{Reg.StreetAddress}}, {{Reg.PostalCode }} -
                                                {{Reg.City}} -
                                                {{Reg.Country}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">VAT ID</p>
                                            <p class="card-text">{{Reg.VatID}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Person registering
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.FirstName}} {{Reg.LastName}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.Email}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            {% if Reg.LEARCompleted %}
                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Legal Representative
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.LRFirstName}} {{Reg.LRLastName}}</p>
                                            <p class="h5">Nationality</p>
                                            <p class="card-text">{{Reg.LRCountry}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.LREmail}}</p>
                                            <p class="h5">ID Card</p>
                                            <p class="card-text">{{Reg.LRIdCard}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Account Admin (LEAR)
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-start">
                                        <div class="col">
                                            <p class="h5">Name</p>
                                            <p class="card-text">{{Reg.LEARFirstName}} {{Reg.LEARLastName}}</p>
                                            <p class="h5">Nationality</p>
                                            <p class="card-text">{{Reg.LEARCountry}}</p>
                                        </div>
                                        <div class="col">
                                            <p class="h5">Email</p>
                                            <p class="card-text">{{Reg.LEAREmail}}</p>
                                            <p class="h5">ID Card</p>
                                            <p class="card-text">{{Reg.LEARIdCard}}</p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            {% endif %}

                        </div>

                        <!-- Process Status -->
                        <div class="col-4">

                            <div class="card card-primary card-outline mb-3">
                                <div class="card-header">
                                    Process Status
                                </div>
                                <div class="card-body">

                                    <ul class="list-group mb-3">
                                        <li class="list-group-item active" aria-current="true">Stage 1</li>
                                        <li class="list-group-item">
                                            <span
                                                class="badge {{ Reg.Notified|yesno:'text-bg-success,text-bg-danger' }}">
                                                Email Notification
                                            </span>
                                        </li>
                                        <li class="list-group-item">
                                            <span class="badge {{ Reg.Issued|yesno:'text-bg-success,text-bg-danger' }}">
                                                Credential issued
                                            </span>
                                        </li>
                                    </ul>

                                    {% if Reg.LEARCompleted %}
                                    <ul class="list-group">
                                        <li class="list-group-item active" aria-current="true">Stage 2</li>
                                        <li class="list-group-item">
                                            <span
                                                class="badge {{ Reg.LEARCompleted|yesno:'text-bg-success,text-bg-danger' }}">
                                                LEAR data
                                            </span>
                                        </li>
                                        <li class="list-group-item">
                                            {% if Reg.Approved == 0 %}
                                            <span
                                                class="badge {{ Reg.Approved|yesno:'text-bg-success,text-bg-warning' }}">
                                                Pending approval
                                            </span>
                                            {% endif %}
                                            {% if Reg.Approved == 1 %}
                                            <span
                                                class="badge {{ Reg.Approved|yesno:'text-bg-success,text-bg-success' }}">
                                                Approved
                                            </span>
                                            {% endif %}
                                            {% if Reg.Approved == 2 %}
                                            <span
                                                class="badge {{ Reg.Approved|yesno:'text-bg-success,text-bg-danger' }}">
                                                Rejected
                                            </span>
                                            {% endif %}
                                        </li>
                                    </ul>
                                    {% endif %}

                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Activity Log -->
                    <div class="card card-primary card-outline mb-3">
                        <div class="card-header">
                            Activity Log
                        </div>
                        <div class="card-body">
                            <div id="log-table"></div>
                        </div>
                    </div>

                </div>
            </div>
        </main>

    </div>

    <script>
        // Initialize Tabulator for the Logs table
        var table = new Tabulator("#log-table", {
            ajaxResponse: function (url, params, response) {
                //url - the URL of the request
                //params - the parameters passed with the request
                //response - the JSON object returned in the body of the response.
                return response.data; //return the tableData property of a response json object
            },
            pagination: true,
            paginationSize: 100,
            paginationCounter: "rows",
            paginationCounterElement: "#org-count",
            layout: "fitDataFill",
            columns: [
                {
                    title: "Date", field: "created_at", formatter: function (cell, formatterParams, onRendered) {
                        const data = cell.getData();
                        const createdAt = new Date(data.created_at);
                        var content = `<div>${createdAt.toLocaleDateString("es-ES")}</div>`;
                        return content;
                    }
                },
                { title: "Type", field: "type" },
                { title: "Message", field: "message" }
            ],
            ajaxURL: "/admin/api/registration-log?vat_id={{Reg.VatID}}",

        });
    </script>


</body>

{% include "partials/bottom.html.j2" %}