<!DOCTYPE html>
<html lang="en">

<head>
    <title>Registrations</title>
    <!-- AdminLTE 4 + Bootstrap 5.3 (CSS) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/css/adminlte.min.css" />

    <!-- Bootstrap + Popper + AdminLTE (JS) -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"></script>
    <script
        src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.10.0/dist/js/adminlte.min.js"></script>

    <link href="https://unpkg.com/tabulator-tables@6.5.0/dist/css/tabulator.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"></script>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- Header -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="#" class="brand-link">
                    <span class="brand-text fw-light">Onboarding</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                        <li class="nav-item">
                            <a href="/admin/registrations" class="nav-link active">
                                <i class="nav-icon bi bi-speedometer"></i>
                                <p>Registrations</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/organizations" class="nav-link">
                                <i class="nav-icon bi bi-bar-chart"></i>
                                <p>Organizations</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <h3 class="mb-0"><span id="org-count"></span> (Organizations)</span></h3>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <div id="tmf-table" style="width: 100%;"></div>
                </div>
            </div>
        </main>

    </div>

    <script>

        // Initialize Tabulator
        var table = new Tabulator("#tmf-table", {
            height: "100%",
            pagination: true,
            paginationSize: 100,
            paginationCounter: "rows",
            paginationCounterElement: "#org-count",
            layout: "fitDataFill",
            columns: [
                {
                    title: "Role", field: "role", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = `<div class="fw-bold">${data.role}</div>`;

                        return content;
                    }
                },
                {
                    title: "Org", field: "company_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = `<div class="fw-bold">${data.company_name}</div>`;
                        content = content + `<div class="text-body-secondary">${data.vat_id}</div>`;
                        content = content + `<div class="text-body-secondary">Country: ${data.country}</div>`;

                        return content;
                    }
                },
                {
                    title: "Dates", field: "created_at", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        const createdAt = new Date(data.created_at);
                        const updatedAt = new Date(data.updated_at);

                        var content = `<div>${createdAt.toLocaleDateString("es-ES")}</div>`;
                        content = content + `<div>${updatedAt.toLocaleDateString("es-ES")}</div>`;

                        return content;
                    }
                },
                {
                    title: "Contact", field: "contact_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = `<div> ${data.first_name} ${data.last_name}</div>`;
                        content = content + `<div class="text-body-secondary">${data.email}</div>`;

                        return content;
                    }
                },
                {
                    title: "Step 1", field: "status", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        const notifiedStyle = data.notified ? "border: 1px solid green;color:green;margin-bottom:3px;" : "border: 1px solid red;color:red;margin-bottom:3px;";
                        const notifiedText = data.notified ? "Email sent" : "Email Not Sent";

                        var content = `<div class="fw-bold" style="${notifiedStyle}">${notifiedText}</div>`;

                        const issuedStyle = data.issued ? "border: 1px solid green;color:green;" : "border: 1px solid red;color:red;";
                        const issuedText = data.issued ? "Issued" : "Not Issued";

                        content = content + `<div class="fw-bold" style="${issuedStyle}">${issuedText}</div>`;

                        return content;
                    }
                },
                {
                    title: "Legal Representative", field: "lr_first_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = ""

                        if (data.lear_completed) {
                            content = `<div class="fw-bold"> ${data.lr_first_name} ${data.lr_last_name}</div>`;
                            content = content + `<div class="text-body-secondary">${data.lr_email}</div>`;
                            content = content + `<div class="text-body-secondary">Country: ${data.lr_country}</div>`;
                        }

                        return content;
                    }
                },
                {
                    title: "LEAR", field: "lear_first_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = ""

                        if (data.lear_completed) {
                            content = `<div class="fw-bold"> ${data.lear_first_name} ${data.lear_last_name}</div>`;
                            content = content + `<div class="text-body-secondary">${data.lear_email}</div>`;
                            content = content + `<div class="text-body-secondary">Country: ${data.lear_country}</div>`;
                        }

                        return content;
                    }
                },
                {
                    title: "Step 2", field: "lear_completed", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        const completedStyle = data.lear_completed ? "border: 1px solid green;color:green;margin-bottom:3px;" : "border: 1px solid red;color:red;margin-bottom:3px;";
                        const completedText = data.lear_completed ? "LEAR" : "LEAR";

                        var content = `<div class="fw-bold" style="${completedStyle}">${completedText}</div>`;

                        const approvedStyle = data.approved ? "border: 1px solid green;color:green;" : "border: 1px solid orange;color:orange;";
                        const approvedText = data.approved ? "Approved" : "Not Approved";
                        content = content + `<div class="fw-bold" style="${approvedStyle}">${approvedText}</div>`;

                        return content;
                    }
                }
            ],
            ajaxURL: "{{ APIJson | safe }}",
        });
    </script>
</body>

</html>