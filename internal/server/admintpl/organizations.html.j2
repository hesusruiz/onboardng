{% include "partials/top.html.j2" with title="Organizations" %}

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        {% include "partials/header.html.j2" %}
        {% include "partials/sidebar.html.j2" with page="organizations" %}

        <!-- Main content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <h3 class="mb-0"><span id="org-count">Organizations: </span></h3>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <div id="tmf-table"></div>
                </div>
            </div>
        </main>

    </div>

    <script>
        // Initialize Tabulator
        var table = new Tabulator("#tmf-table", {
            pagination: true,
            paginationSize: 100,
            paginationCounter: "rows",
            paginationCounterElement: "#org-count",
            layout: "fitDataFill",
            columns: [
                { title: "VAT ID", field: "vatId" },
                {
                    title: "VIES Status", field: "viesError", variableHeight: true, formatter: "html"
                },
                { title: "Trading Name", field: "tradingName" },
                { title: "Email", field: "emailAddress" },
                {
                    title: "Link", field: "href", formatter: "link", formatterParams: {
                        labelField: "href",
                        target: "_blank",
                    }
                }
            ],
            ajaxURL: "{{ APIJson | safe }}",
        });
    </script>
</body>

{% include "partials/bottom.html.j2" %}