{% include "partials/top.html.j2" with title="Regs & Orgs" %}

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        {% include "partials/header.html.j2" %}
        {% include "partials/sidebar.html.j2" with page="regsorgs" %}

        <!-- Main content -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <h3 class="mb-0"><span id="org-count">Regs & Orgs: </span></h3>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <div id="tmf-table" style="width: 100%;"></div>
                </div>
            </div>
        </main>

    </div>

    <script>

        // Initialize Tabulator
        var table = new Tabulator("#tmf-table", {
            height: "100%",
            pagination: true,
            paginationSize: 100,
            paginationCounter: "rows",
            paginationCounterElement: "#org-count",
            layout: "fitDataFill",
            rowFormatter: function (row) {
                if (row.getData().role == "Seller") {
                    row.getElement().style.backgroundColor = "#cff4fc";
                }
            },
            columns: [
                {
                    title: "Role", field: "role", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = `<div>${data.role}</div>`;
                        if (data.role) {
                            if (data.role === "Seller") {
                                content = `<div class="fw-bold">${data.role}</div>`;
                            }
                        }

                        return content;
                    }
                },
                {
                    title: "TMF", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        if (data.Org.id) {
                            var content = `<div style="color:green">YES</div>`;
                            return content
                        } else {
                            var content = `<div style="color:red">NO</div>`;
                            return content
                        }

                        return "";
                    }
                },
                {
                    title: "Msg", field: "errors", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = ``

                        const errors = data.Errors || []
                        const warnings = data.Warnings || []

                        // Iterate the warnings and errors arrays and create a div for each warning and error
                        warnings.forEach(function (warning) {
                            content = content + `<div class="fw-bold" style="color:orange">${warning}</div>`
                        })

                        errors.forEach(function (error) {
                            content = content + `<div class="fw-bold" style="color:red">${error}</div>`
                        })

                        return content;
                    }
                },
                {
                    title: "Org", field: "company_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = ``

                        if (data.company_name) {
                            if (data.Org.tradingName && data.Org.tradingName !== data.company_name) {
                                content = content + `<div class="fw-bold" style="color:red">Reg: ${data.company_name}</div>`;
                                content = content + `<div class="fw-bold" style="color:red">Org: ${data.Org.tradingName}</div>`;
                            } else {
                                content = content + `<div class="fw-bold">${data.company_name}</div>`
                            }
                        } else {
                            if (data.Org.tradingName) {
                                content = content + `<div class="fw-bold">${data.Org.tradingName}</div>`
                            }
                        }

                        if (data.vat_id) {
                            if (data.Org.vatId && data.Org.vatId !== data.vat_id) {
                                content = content + `<div class="fw-bold" style="color:red">Reg: ${data.vat_id}</div>`;
                                content = content + `<div class="fw-bold" style="color:red">Org: ${data.Org.vatId}</div>`;
                            } else {
                                content = content + `<div>${data.vat_id}</div>`;
                            }
                            content = content + `<div>Country: ${data.country}</div>`;
                        } else {
                            if (data.Org.vatId) {
                                content = content + `<div>${data.Org.vatId}</div>`;
                            }
                        }

                        return content;
                    }
                },
                {
                    title: "Dates", field: "created_at", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        if (data.vat_id) {
                            const createdAt = new Date(data.created_at);
                            const updatedAt = new Date(data.updated_at);

                            var content = `<div>${createdAt.toLocaleDateString("es-ES")}</div>`;
                            content = content + `<div>${updatedAt.toLocaleDateString("es-ES")}</div>`;
                            return content
                        }

                        return "";
                    }
                },
                {
                    title: "Contact", field: "contact_name", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        var content = `<div class="fw-bold"> ${data.first_name} ${data.last_name}</div>`;
                        content = content + `<div>${data.email}</div>`;

                        return content;
                    }
                },
                {
                    title: "Step 1", field: "status", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        if (data.vat_id) {
                            const notifiedStyle = data.notified ? "border: 1px solid green;color:green;margin-bottom:3px;" : "border: 1px solid red;color:red;margin-bottom:3px;";
                            const notifiedText = data.notified ? "Email sent" : "Email Not Sent";

                            var content = `<div class="fw-bold" style="${notifiedStyle}">${notifiedText}</div>`;

                            const issuedStyle = data.issued ? "border: 1px solid green;color:green;" : "border: 1px solid red;color:red;";
                            const issuedText = data.issued ? "Issued" : "Not Issued";

                            content = content + `<div class="fw-bold" style="${issuedStyle}">${issuedText}</div>`;
                            return content
                        }

                        return "";
                    }
                },
                {
                    title: "Step 2", field: "lear_completed", formatter: function (cell, formatterParams, onRendered) {
                        const value = cell.getValue();
                        const data = cell.getData();

                        if (data.lear_completed) {
                            const completedStyle = data.lear_completed ? "border: 1px solid green;color:green;margin-bottom:3px;" : "border: 1px solid red;color:red;margin-bottom:3px;";
                            const completedText = data.lear_completed ? "LEAR data" : "LEAR data";

                            var content = `<div class="fw-bold" style="${completedStyle}">${completedText}</div>`;

                            const approvedStyle = data.approved ? "border: 1px solid green;color:green;" : "border: 1px solid orange;color:orange;";
                            const approvedText = data.approved ? "Approved" : "Not Approved";
                            content = content + `<div class="fw-bold" style="${approvedStyle}">${approvedText}</div>`;
                            return content
                        }

                        return "";
                    }
                }
            ],
            ajaxURL: "{{ APIJson | safe }}",
        });

        table.on("rowClick", function (e, row) {
            //e - the click event object
            //row - row component
            var data = row.getData();
            if (data.vat_id) {
                location = "/admin/oneregistration?vat_id=" + data.vat_id
            } else if (data.Org.id) {
                location = "{{tmfOrganizationUrl}}/" + data.Org.id
            } else {
                alert("No object to display")
            }
        });
    </script>
</body>

</html>