        <div class="w3-container" style="padding: 0;">
            <div class="dashboard-card">
                <div class="card-header">
                    <h3><i class="fa fa-list"></i> Active Partner Registrations</h3>
                    <span class="subtitle">Showing {{ .Total }} of {{ .NumEntries }} entries</span>
                </div>

                <div class="table-responsive">
                    <table class="list-table">
                        <thead>
                            <tr>
                                <th style="width: 60px; text-align: center;">Type</th>
                                <th>Company Profile</th>
                                <th>Dates</th>
                                <th>Person Registering</th>
                                <th>Stage 1 Status</th>
                                <th>Legal Representative</th>
                                <th>Account Admin (LEAR)</th>
                                <th>Stage 2 Status</th>
                                <th style="text-align: center; width: 120px;">Global Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .Regs }}
                            <!-- Entry 1: Pending Final Review -->
                            <tr onclick="window.location='/admin/registration?vat_id={{ .VatID }}';">
                                <td>
                                    <div class="type-cell">
                                        {{ if eq .Role "Seller" }}
                                        <span class="type-icon seller" title="Seller"><i
                                                class="fa fa-handshake-o"></i></span>
                                        <span>Seller</span>
                                        {{ else }}
                                        <span class="type-icon buyer" title="Buyer"><i
                                                class="fa fa-shopping-cart"></i></span>
                                        <span>Buyer</span>
                                        {{ end }}
                                    </div>
                                </td>
                                <td>
                                    <div class="meta-stack">
                                        <span class="meta-title">{{ .CompanyName }}</span>
                                        <span class="meta-subtitle">VAT ID: <span class="meta-value">{{ .VatID
                                                }}</span></span>
                                        <span class="meta-subtitle">Country: <span class="meta-title"
                                                style="font-size: 11px;">{{ .Country }}</span></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="meta-stack">
                                        <span class="meta-subtitle">Created</span>
                                        <span class="date-text">{{ .CreatedAt.Format "2006-01-02 15:04:05"
                                            }}</span>
                                        <span class="meta-subtitle" style="margin-top: 4px;">Updated</span>
                                        <span class="date-text">{{ .UpdatedAt.Format "2006-01-02 15:04:05"
                                            }}</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="meta-stack">
                                        <span class="meta-title">{{ .FirstName }} {{ .LastName }}</span>
                                        <span class="meta-subtitle meta-email"><a href="mailto:{{ .Email }}"
                                                onclick="event.stopPropagation();">{{ .Email
                                                }}</a></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="badge-list">
                                        <span
                                            class="badge {{ if .Notified }}badge-success{{ else }}badge-danger{{ end }}"
                                            title="{{ if .Notified }}Welcome email sent successfully to customer{{ else }}Welcome email to customer pending or failed{{ end }}">Notified</span>
                                        <span class="badge {{ if .Issued }}badge-success{{ else }}badge-danger{{ end }}"
                                            title="{{ if .Issued }}Verifiable Credential issued successfully{{ else }}Verifiable Credential pending or failed{{ end }}">Issued</span>
                                        <span
                                            class="badge {{ if .TMFRegistered }}badge-success{{ else }}badge-danger{{ end }}"
                                            title="{{ if .TMFRegistered }}Registered in TMF successfully{{ else }}Registration in TMF pending or failed{{ end }}">In
                                            TMF</span>
                                    </div>
                                </td>

                                {{ if .LEARCompleted }}
                                <!-- Legal Representative -->
                                <td>
                                    <div class="meta-stack">
                                        <span class="meta-title">{{ .LRFirstName }} {{ .LRLastName }}</span>
                                        <span class="meta-subtitle meta-email"><a href="mailto:{{ .LREmail }}"
                                                onclick="event.stopPropagation();">{{
                                                .LREmail }}</a></span>
                                        {{ if .LRCountry}}
                                        <span class="meta-subtitle">Nationality: <span>{{ .LRCountry }}</span></span>
                                        {{ end }}
                                    </div>
                                </td>


                                <!-- Lear -->
                                <td>
                                    <div class="meta-stack">
                                        <span class="meta-title">{{ .LEARFirstName }} {{ .LEARLastName }}</span>
                                        <span class="meta-subtitle meta-email"><a href="mailto:{{ .LEAREmail }}"
                                                onclick="event.stopPropagation();">{{
                                                .LEAREmail }}</a></span>
                                        {{ if .LEARCountry}}
                                        <span class="meta-subtitle">Nationality: <span>{{ .LEARCountry }}</span></span>
                                        {{ end }}
                                    </div>
                                </td>


                                <!-- Status of second stage -->
                                <td>
                                    <div class="badge-list">
                                        <span
                                            class="badge {{ if .LEARCompleted }}badge-success{{ else }}badge-danger{{ end }}">LEAR</span>
                                        <span
                                            class="badge {{ if .FilesUploaded }}badge-success{{ else }}badge-danger{{ end }}">Uploads</span>
                                    </div>
                                </td>

                                {{ else }}
                                <td></td>
                                <td></td>
                                <td></td>
                                {{ end }}

                                <!-- Global Status -->
                                <td style="text-align: center; vertical-align: middle;">
                                    <div class="status-action-container">

                                        {{ if .LEARCompleted}}

                                        {{ if eq .Approved 0 }}
                                        <span class="badge badge-warning">
                                            Pending Review
                                        </span>
                                        {{ else if eq .Approved 1 }}
                                        <span class="badge badge-success">
                                            Approved
                                        </span>
                                        {{ else if eq .Approved 2 }}
                                        <span class="badge badge-danger">
                                            Rejected
                                        </span>
                                        {{ end }}
                                        {{ end }}

                                        <a href="/admin/registration?vat_id={{ .VatID }}" class="action-btn"
                                            title="Open Registration Details" onclick="event.stopPropagation();">
                                            <i class="fa fa-folder-open-o"></i> Open
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{ end }}

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>

</html>