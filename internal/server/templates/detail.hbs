<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Registration Detail - Onboarding Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-tertiary": "#ffffff",
                        "surface-container-low": "#f0f4f8",
                        "error-container": "#ffdad6",
                        "on-background": "#171c1f",
                        "tertiary-fixed-dim": "#ffb695",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed": "#ffdbcc",
                        "on-tertiary-fixed": "#351000",
                        "on-primary-fixed": "#0f0069",
                        "inverse-primary": "#c3c0ff",
                        "on-error-container": "#93000a",
                        "background": "#f6fafe",
                        "on-surface": "#171c1f",
                        "on-secondary": "#ffffff",
                        "surface-dim": "#d6dade",
                        "on-error": "#ffffff",
                        "on-secondary-container": "#57657a",
                        "on-surface-variant": "#464555",
                        "surface-container-high": "#e4e9ed",
                        "inverse-on-surface": "#edf1f5",
                        "on-primary-fixed-variant": "#3323cc",
                        "surface-tint": "#4d44e3",
                        "primary-container": "#4f46e5",
                        "on-secondary-fixed-variant": "#3a485b",
                        "on-primary": "#ffffff",
                        "surface-container-highest": "#dfe3e7",
                        "secondary-fixed": "#d5e3fc",
                        "outline": "#777587",
                        "tertiary": "#7e3000",
                        "primary-fixed": "#e2dfff",
                        "on-secondary-fixed": "#0d1c2e",
                        "on-primary-container": "#dad7ff",
                        "inverse-surface": "#2c3134",
                        "surface-variant": "#dfe3e7",
                        "surface": "#f6fafe",
                        "primary": "#3525cd",
                        "on-tertiary-container": "#ffd2be",
                        "secondary": "#515f74",
                        "surface-container": "#eaeef2",
                        "primary-fixed-dim": "#c3c0ff",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "error": "#ba1a1a",
                        "secondary-container": "#d5e3fc",
                        "tertiary-container": "#a44100",
                        "surface-bright": "#f6fafe",
                        "secondary-fixed-dim": "#b9c7df",
                        "outline-variant": "#c7c4d8"
                    },
                    fontFamily: {
                        "headline": ["Inter"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.375rem", "xl": "0.5rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
    </style>
</head>

<body class="bg-background text-on-surface min-h-screen">
    <!-- TopNavBar -->
    <header
        class="bg-white dark:bg-slate-950 flex justify-between items-center w-full px-6 py-3 max-w-full mx-auto border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50">
        <div class="flex items-center gap-8">
            <div class="text-xl font-black text-indigo-600 dark:text-indigo-400 tracking-tighter uppercase" style="">
                Onboarding Admin</div>
        </div>
    </header>
    <main class="max-w-[1400px] mx-auto px-6 py-8">
        <!-- Breadcrumb / Header Actions -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
            <div>
                <a class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm mb-2 group transition-all"
                    href="/admin/index" style="">
                    <span class="material-symbols-outlined mr-1 text-lg group-hover:-translate-x-1 transition-transform"
                        data-icon="arrow_back" style="">arrow_back</span>
                    Back to Registrations
                </a>

                <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight" style="">Registration Detail</h1>
                <p class="text-on-surface-variant font-medium mt-1" style="">ID: {{ .Reg.RegistrationID }} • Submitted
                    on
                    {{ .Reg.CreatedAt.Format "Jan 2, 2006" }}
                </p>
            </div>
            <div class="flex gap-3">
                {{ if eq .Reg.Approved 0 }}
                <span class="px-6 py-2.5 bg-blue-100 text-blue-700 border-2 border-blue-300 rounded-lg text-sm font-extrabold
                uppercase tracking-widest" style="">Full Onboard: PENDING</span>
                {{end}}
                {{ if eq .Reg.Approved 1 }}
                <span
                    class="px-6 py-2.5 bg-green-100 text-green-700 border-2 border-green-300 rounded-lg text-sm font-extrabold uppercase tracking-widest"
                    style="">Full Onboard: APPROVED</span>
                {{end}}
                {{ if eq .Reg.Approved 2 }}
                <span
                    class="px-6 py-2.5 bg-red-100 text-red-700 border-2 border-red-300 rounded-lg text-sm font-extrabold uppercase tracking-widest"
                    style="">Full Onboard: REJECTED</span>
                {{end}}
            </div>
            <div class="flex gap-3">
                <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                    <input type="hidden" name="status" value="approved">
                    <button
                        class="px-6 py-2.5 bg-primary text-on-primary font-bold rounded hover:bg-primary-container transition-all shadow-md active:scale-[0.98]"
                        style="">
                        Approve
                    </button>
                </form>
                <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                    <input type="hidden" name="status" value="rejected">
                    <button
                        class="px-6 py-2.5 bg-error text-on-error font-bold rounded hover:bg-error-container transition-all shadow-md active:scale-[0.98]"
                        style="">
                        Reject
                    </button>
                </form>
                <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                    <input type="hidden" name="status" value="pending">
                    <button
                        class="px-6 py-2.5 bg-white border border-outline-variant text-on-surface font-bold rounded hover:bg-surface-container-low transition-all shadow-sm active:scale-[0.98]"
                        style="">
                        Set Pending
                    </button>
                </form>

            </div>
        </div>
        <!-- Top Content Area with Sidebar -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
            <!-- Left Column: Main Info -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Basic Information -->
                <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                    <div class="flex items-center gap-2 mb-6 border-b border-outline-variant pb-4">
                        <span class="material-symbols-outlined text-indigo-600" data-icon="person"
                            style="">person</span>

                        <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Basic
                            Information</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Full Name</label>
                            <p class="text-lg font-bold text-slate-900" style="">{{ .Reg.FirstName }}
                                {{ .Reg.LastName }}
                            </p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Email Address</label>
                            <p class="text-lg font-bold text-slate-900" style="">{{ .Reg.Email }}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Proposed Role</label>
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200"
                                style="">
                                {{ .Reg.Role }}</span>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Submission Date</label>
                            <p class="text-lg font-bold text-slate-900" style="">
                                {{ .Reg.UpdatedAt.Format "2006-01-02 15:04:05" }}
                            </p>
                        </div>
                    </div>
                </section>
                <!-- Company Profile -->
                <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                    <div class="flex items-center gap-2 mb-6 border-b border-outline-variant pb-4">
                        <span class="material-symbols-outlined text-indigo-600" data-icon="domain"
                            style="">domain</span>

                        <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Company
                            Profile</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12 mb-6">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Legal Company Name</label>
                            <p class="text-xl font-extrabold text-slate-900" style="">{{ .Reg.CompanyName }}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">VAT ID</label>
                            <p class="text-lg font-bold text-slate-900" style="">{{ .Reg.VatID }}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1"
                                style="">Registration Number</label>
                            <p class="text-lg font-bold text-slate-900" style="">{{ .Reg.RegistrationID }}</p>
                        </div>
                    </div>
                    <div class="bg-surface-container-low p-4 rounded border border-outline-variant">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2"
                            style="">Registered Address</label>
                        <p class="text-slate-800 font-medium leading-relaxed" style="">
                            {{ .Reg.StreetAddress }}<br />
                            {{ .Reg.PostalCode }} {{ .Reg.City }}<br />
                            {{ .Reg.Country }}
                        </p>
                    </div>
                </section>
                <!-- Representatives -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                        <div class="flex items-center gap-2 mb-4 border-b border-outline-variant pb-3">
                            <span class="material-symbols-outlined text-indigo-600 text-xl" data-icon="gavel"
                                style="">gavel</span>

                            <h2 class="text-md font-extrabold text-slate-900 uppercase tracking-tight" style="">Legal
                                Representative</h2>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <p class="font-bold text-slate-900 text-lg" style="">{{ .Reg.LRFirstName }}
                                    {{ .Reg.LRLastName }}
                                </p>
                            </div>
                            <div class="grid grid-cols-1 gap-3">
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                        style="">Email</label>
                                    <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LREmail }}</p>
                                </div>
                                <div class="flex justify-between">
                                    <div>
                                        <label
                                            class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                            style="">Country</label>
                                        <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LRCountry }}</p>
                                    </div>
                                    <div class="text-right">
                                        <label
                                            class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                            style="">ID Card</label>
                                        <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LRIdCard }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                        <div class="flex items-center gap-2 mb-4 border-b border-outline-variant pb-3">
                            <span class="material-symbols-outlined text-indigo-600 text-xl" data-icon="badge"
                                style="">badge</span>

                            <h2 class="text-md font-extrabold text-slate-900 uppercase tracking-tight" style="">LEAR
                                Official</h2>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <p class="font-bold text-slate-900 text-lg" style="">{{ .Reg.LEARFirstName }}
                                    {{ .Reg.LEARLastName }}
                                </p>
                            </div>
                            <div class="grid grid-cols-1 gap-3">
                                <div>
                                    <label
                                        class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                        style="">Email</label>
                                    <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LEAREmail }}</p>
                                </div>
                                <div class="flex justify-between">
                                    <div>
                                        <label
                                            class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                            style="">ID Card</label>
                                        <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LEARIdCard }}</p>
                                    </div>
                                    <div class="text-right">
                                        <label
                                            class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-0.5"
                                            style="">Mobile Number</label>
                                        <p class="text-sm font-bold text-slate-900" style="">{{ .Reg.LEARMobileNumber }}
                                        </p>
                                    </div>
                                </div>
                                <div class="pt-2 border-t border-outline-variant">
                                    <label
                                        class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1"
                                        style="">Postal Address</label>
                                    <p class="text-xs font-bold text-slate-900 leading-tight" style="">
                                        {{ .Reg.LEARAddress }} - {{ .Reg.LEARCountry }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <!-- Internal Notes -->
                <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-indigo-600" data-icon="sticky_note_2"
                                style="">sticky_note_2</span>

                            <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Internal
                                Admin Notes</h2>
                        </div>
                        <span class="text-xs font-bold text-slate-400" style="">Last updated: 2 hours ago</span>
                    </div>
                    <textarea
                        class="w-full h-32 p-4 bg-surface-container-low border border-outline-variant rounded text-slate-800 focus:ring-2 focus:ring-primary focus:border-primary transition-all resize-none font-body placeholder:text-slate-400"
                        placeholder="This is not yet implemented. Admin will be able to enter confidential notes here..."></textarea>
                    <div class="mt-3 flex justify-end">
                        <button
                            class="px-4 py-1.5 bg-slate-900 text-white text-xs font-bold rounded uppercase tracking-widest hover:bg-slate-800 transition-colors"
                            style="">Save Note</button>
                    </div>
                </section>
            </div>
            <!-- Right Column: Process & Logs -->
            <div class="lg:col-span-4 space-y-6">
                <!-- Process Status Sidebar -->
                <section class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 shadow-sm">
                    <div class="flex items-center gap-2 mb-6 border-b border-outline-variant pb-4">
                        <span class="material-symbols-outlined text-indigo-600" data-icon="schema"
                            style="">schema</span>

                        <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Process
                            Status</h2>
                    </div>
                    <div class="space-y-4 mb-8">
                        <!-- Status Items -->
                        <div
                            class="flex items-center justify-between p-3 bg-surface-container-low border border-outline-variant rounded">
                            <div class="flex items-center gap-3">
                                {{ if .Reg.Notified }}
                                <span class="material-symbols-outlined text-green-600" data-icon="check_circle"
                                    style='font-variation-settings: "FILL" 1;'>check_circle</span>
                                {{ else }}
                                <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                    style="">pending</span>
                                {{ end }}
                                <span class="font-bold text-slate-900 text-sm" style="">Registration Notified</span>

                            </div>
                            <button
                                class="px-3 py-1 bg-white border border-green-200 text-green-700 text-[10px] font-bold uppercase tracking-widest rounded hover:bg-green-50 transition-colors"
                                style="">Try again</button>
                        </div>
                        <div
                            class="flex items-center justify-between p-3 bg-surface-container-low border border-outline-variant rounded">
                            <div class="flex items-center gap-3">
                                {{ if .Reg.Issued }}
                                <span class="material-symbols-outlined text-green-600" data-icon="check_circle"
                                    style='font-variation-settings: "FILL" 1;'>check_circle</span>
                                {{ else }}
                                <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                    style="">pending</span>
                                {{ end }}
                                <span class="font-bold text-slate-900 text-sm" style="">Credential Issued</span>
                            </div>
                            <button
                                class="px-3 py-1 bg-white border border-green-200 text-green-700 text-[10px] font-bold uppercase tracking-widest rounded hover:bg-green-50 transition-colors"
                                style="">Try again</button>
                        </div>
                        <div
                            class="flex items-center justify-between p-3 bg-surface-container-low border border-outline-variant rounded">
                            <div class="flex items-center gap-3">
                                {{ if .Reg.TMFRegistered }}
                                <span class="material-symbols-outlined text-green-600" data-icon="check_circle"
                                    style='font-variation-settings: "FILL" 1;'>check_circle</span>
                                {{ else }}
                                <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                    style="">pending</span>
                                {{ end }}
                                <span class="font-bold text-slate-900 text-sm" style="">TMF Registered</span>
                            </div>
                            <button
                                class="px-3 py-1 bg-white border border-green-200 text-green-700 text-[10px] font-bold uppercase tracking-widest rounded hover:bg-green-50 transition-colors"
                                style="">Try again</button>
                        </div>
                        <div class="pt-6 border-t border-dashed border-outline-variant">

                            <div
                                class="flex items-center justify-between p-3 bg-surface-container-low border border-outline-variant rounded">
                                <div class="flex items-center gap-3">
                                    {{ if .Reg.LEARCompleted }}
                                    <span class="material-symbols-outlined text-green-600" data-icon="check_circle"
                                        style='font-variation-settings: "FILL" 1;'>check_circle</span>
                                    {{ else }}
                                    <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                        style="">pending</span>
                                    {{ end }}
                                    <span class="font-bold text-slate-900 text-sm" style="">LEAR Completed</span>
                                </div>
                            </div>
                        </div>

                        <div
                            class="flex items-center justify-between p-3 bg-surface-container-low border border-outline-variant rounded">
                            <div class="flex items-center gap-3">
                                {{ if .Reg.FilesUploaded }}
                                <span class="material-symbols-outlined text-indigo-600" data-icon="cloud_done"
                                    style='font-variation-settings: "FILL" 1;'>cloud_done</span>
                                {{ else }}
                                <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                    style="">pending</span>
                                {{ end }}
                                <span class="font-bold text-slate-900 text-sm" style="">Files Uploaded</span>
                            </div>
                        </div>
                    </div>
                    <!-- Verified Separated Toggle -->
                    <div class="pt-6 border-t border-dashed border-outline-variant">
                        <div
                            class="flex items-center justify-between bg-indigo-50 border border-indigo-200 p-4 rounded-lg">
                            {{ if eq .Reg.Approved 1 }}
                            <span class="material-symbols-outlined text-green-600" data-icon="check_circle"
                                style='font-variation-settings: "FILL" 1;'>check_circle</span>
                            {{ else }}
                            <span class="material-symbols-outlined text-slate-400" data-icon="pending"
                                style="">pending</span>
                            {{ end }}

                            <div>
                                <p class="text-indigo-900 font-extrabold text-sm uppercase tracking-tight" style="">
                                    Final Verification</p>
                                <p class="text-[10px] font-bold text-indigo-600 uppercase" style="">Confirm all checks
                                    passed</p>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Help/Documentation Widget -->
                <div class="p-6 bg-slate-900 rounded-lg text-white">
                    <h3 class="font-black uppercase tracking-tighter text-indigo-400 mb-2" style="">Compliance Guide
                    </h3>
                    <p class="text-xs text-slate-400 leading-relaxed mb-4" style="">Ensure all LEAR official
                        appointments follow the 2024 Regulatory Guidelines Chapter 4.2 regarding digital signatures.</p>
                    <a class="inline-flex items-center text-xs font-bold text-white bg-indigo-600 px-4 py-2 rounded uppercase tracking-widest hover:bg-indigo-500 transition-colors"
                        href="#" style="">
                        View SOP
                        <span class="material-symbols-outlined text-sm ml-2" data-icon="open_in_new"
                            style="">open_in_new</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Full Width Sections -->
        <div class="space-y-6">
            <!-- Uploaded Documents -->
            <section
                class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-white flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-indigo-600" data-icon="folder_open"
                            style="">folder_open</span>

                        <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Uploaded
                            Documents</h2>
                    </div>
                    <span class="px-2 py-0.5 bg-slate-100 rounded text-[10px] font-black uppercase tracking-tighter"
                        style="">4 Files Total</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-surface-container-low border-b border-outline-variant">
                            <tr>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Document Name</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Size</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Created</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Updated</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">
                            {{ range .Files }}

                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <a download="{{ .Name }}"
                                        class="font-bold text-indigo-600 hover:text-indigo-800 hover:underline"
                                        href="/admin/api/file/{{ .FileID }}" style="">{{ .Name }}</a>
                                </td>
                                <td class="px-6 py-4 text-sm font-medium text-slate-500" style="">{{ .Size }}</td>
                                <td class="px-6 py-4 text-sm font-medium text-slate-500" style="">{{ .CreatedAt | date
                                    "2006-01-02 15:04:05" }}</td>
                                <td class="px-6 py-4 text-sm font-medium text-slate-500" style="">{{ .UpdatedAt | date
                                    "2006-01-02 15:04:05" }}</td>
                                <td class="px-6 py-4" style=""><select
                                        class="appearance-none px-3 py-1 rounded-full text-[10px] font-bold bg-green-100 text-green-700 border border-green-200 uppercase tracking-wider focus:ring-2 focus:ring-green-500 focus:outline-none cursor-pointer">
                                        <option selected="" value="approved">Approved</option>
                                        <option value="in_review">In Review</option>
                                        <option value="rejected">Rejected</option>
                                    </select></td>
                            </tr>

                            {{ end }}

                        </tbody>
                    </table>
                </div>
            </section>
            <!-- Registration Activity Log -->
            <section
                class="bg-surface-container-lowest border border-outline-variant rounded-lg shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-white flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-indigo-600" data-icon="history"
                            style="">history</span>

                        <h2 class="text-xl font-extrabold text-slate-900 uppercase tracking-tight" style="">Registration
                            Activity Log</h2>
                    </div>
                    <button class="text-[10px] font-black text-indigo-600 hover:underline uppercase tracking-widest"
                        style="">Full History</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-surface-container-low border-b border-outline-variant">
                            <tr>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest"
                                    style="">Type</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest w-full"
                                    style="">Details</th>
                                <th class="px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest text-right"
                                    style="">Date / Time</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant">

                            {{ range .Logs }}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4" style="">
                                    {{ if eq .Type "info" }}
                                    <span
                                        class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white uppercase tracking-wider"
                                        style="">Info</span>
                                    {{ end }}
                                    {{ if eq .Type "warning" }}
                                    <span
                                        class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-white uppercase tracking-wider"
                                        style="">Warning</span>
                                    {{ end }}
                                    {{ if eq .Type "error" }}
                                    <span
                                        class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-600 text-white uppercase tracking-wider"
                                        style="">Error</span>
                                    {{ end }}
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600 w-full whitespace-normal" style="">
                                    {{ .Message }}
                                </td>
                                <td class="px-6 py-4 text-right" style="">
                                    <p class="text-xs font-black text-slate-400 uppercase tracking-tighter" style="">
                                        {{ .CreatedAt | date "2006-01-02" }}
                                    </p>
                                    <p class="text-[10px] font-bold text-slate-500" style="">
                                        {{ .CreatedAt | date "15:04" }}
                                    </p>
                                </td>
                            </tr>
                            {{ end }}

                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
    <!-- Mobile Bottom Navigation -->
    <div
        class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 px-6 py-2 flex justify-between items-center z-50">
        <button class="flex flex-col items-center gap-1 text-slate-400" style="">
            <span class="material-symbols-outlined" data-icon="dashboard" style="">dashboard</span>
            <span class="text-[10px] font-bold uppercase" style="">Home</span>
        </button>
        <button class="flex flex-col items-center gap-1 text-indigo-600" style="">
            <span class="material-symbols-outlined" data-icon="how_to_reg"
                style='font-variation-settings: "FILL" 1;'>how_to_reg</span>
            <span class="text-[10px] font-bold uppercase" style="">Registrations</span>
        </button>
        <button class="flex flex-col items-center gap-1 text-slate-400" style="">
            <span class="material-symbols-outlined" data-icon="group" style="">group</span>
            <span class="text-[10px] font-bold uppercase" style="">Users</span>
        </button>
        <button class="flex flex-col items-center gap-1 text-slate-400" style="">
            <span class="material-symbols-outlined" data-icon="settings" style="">settings</span>
            <span class="text-[10px] font-bold uppercase" style="">Setup</span>
        </button>
    </div>
</body>

</html>