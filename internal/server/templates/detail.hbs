<!DOCTYPE html>
<html lang="en">

{{/*
Variables passed to this template

Email string
Reg *db.RegistrationRecord
Files []db.RegistrationFile
Logs []db.RegistrationLog

// RegistrationRecord represents a user registration record in the database
type RegistrationRecord struct {

--// The first step of registration, called a "solo" registration, without real verification
--//

--// Unique identifier of the registration
--RegistrationID string `json:"registration_id"`

--// Email of the person/user performing the registration. The email will be verified by sending a verification code
--// to the email supplied.
--Email string `json:"email"`

--// Name and surname of the user
--FirstName string `json:"first_name"`
--LastName string `json:"last_name"`

--// Identification of the company that the user is registering
--// Official name of the company as it appears in the registry of incorporation
--CompanyName string `json:"company_name"`
--
--// Country code (two-letter code) of incorporation of the company
--Country string `json:"country"`
--
--// VAT ID of the company. Together with the country code, it is the unique identifier of the company
--VatID string `json:"vat_id"`
--
--// Street address of the company
--StreetAddress string `json:"street_address"`
--
--// City of the company
--City string `json:"city"`
--
--// Postal code of the company
--PostalCode string `json:"postal_code"`
--
--// Role of the company in DOME (Seller or Buyer)
--Role string `json:"role"`

--// Timestamps of the registration record
--CreatedAt time.Time `json:"created_at"`
--UpdatedAt time.Time `json:"updated_at"`

--// Flags for the sub-steps of the first step of registration
--// true if an email has been sent to the user to notify him about the registration
--Notified bool `json:"notified"`
--// true if the Verifiable credential has been issued to the user
--Issued bool `json:"issued"`
--// true if the user has been registered in the TMF
--TMFRegistered bool `json:"tmf_registered"`

--
--// The second step of the registration, when the company formalizes the registration
--//

--// Identification data about the Legal Representative of the company
--LRFirstName string `json:"lr_first_name"`
--LRLastName string `json:"lr_last_name"`
--LREmail string `json:"lr_email"`
--LRCountry string `json:"lr_country"`
--LRIdCard string `json:"lr_id_card"`

--// Identification data about the Legal Entity Authorized Representative (LEAR) of the company
--// This is the person who will represent the company in DOME and act as the main contact for the company
--LEARFirstName string `json:"lear_first_name"`
--LEARLastName string `json:"lear_last_name"`
--LEAREmail string `json:"lear_email"`
--LEARCountry string `json:"lear_country"`
--LEARAddress string `json:"lear_address"`
--LEARIdCard string `json:"lear_id_card"`
--LEARMobileNumber string `json:"lear_mobile_number"`

--// State of the second step of registration
--// Data about the LR has been successfully registered
--// TODO: this field is not being used now (and is not useful), perform a migration to detele it
--LRCompleted bool `json:"lr_completed"`
--// Data about the LEAR has been successfully registered
--LEARCompleted bool `json:"lear_completed"`
--// Files about the company's official registration and the LEAR have been provided, but may be pending its
verification
--FilesUploaded bool `json:"files_uploaded"`
--// Status of the second step: 0 = pending, 1 = approved, 2 = rejected
--Approved int `json:"approved"`
}

// RegistrationLog represents a log entry (info, warning, error) during the registration process
type RegistrationLog struct {
--RegistrationID string `json:"registration_id"`
--Email string `json:"email"`
--VatID string `json:"vat_id"`
--Type string `json:"type"` // info, warning, error
--Message string `json:"message"`
--CreatedAt time.Time `json:"created_at"`
}

// RegistrationFile represents a file uploaded by a user during registration
type RegistrationFile struct {
--FileID string `json:"file_id"`
--RegistrationID string `json:"registration_id"`
--VatID string `json:"vat_id"`
--Name string `json:"name"`
--MimeType string `json:"mime_type"`
--Size int64 `json:"size"`
--Status string `json:"status"`
--Content []byte `json:"content"`
--CreatedAt time.Time `json:"created_at"`
--UpdatedAt time.Time `json:"updated_at"`
}
*/}}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Detail - Operational Dashboard</title>

    <!-- External stylesheet dependencies -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/admin/styles.css" />
</head>

<body>
    <!-- Portal Top Header -->
    <header class="portal-header">
        <div class="portal-header-left">
            <img src="https://dome-marketplace.eu/assets/logos/DOME_Logo_White_Name.svg" alt="DOME Logo"
                class="portal-logo">
        </div>
        <div class="portal-header-center">
            <span class="portal-title">Onboard Admin</span>
        </div>
        <div class="portal-header-right">
            <span class="header-user">{{ .Email }}</span>
            <a href="/passkeys/api/logout" class="portal-btn portal-btn-solid">Logout</a>
        </div>
    </header>

    <main>

        <!-- Top Header Navigation -->
        <header class="dashboard-header">
            <div class="header-title-wrapper">
                <a href="/admin/index" class="back-link">
                    <i class="fa fa-arrow-left"></i> Back to Registrations
                </a>

                <h1 class="dashboard-title">Registration Details</h1>
                <p class="subtitle">ID: <span style="font-family: monospace; font-weight: 700;">{{ .Reg.RegistrationID
                        }}</span> &bull; Submitted
                    {{ .Reg.CreatedAt.Format "Jan 2, 2006" }}
                </p>
            </div>
            <div>
                {{ if eq .Reg.Approved 0 }}
                <span class="badge badge-warning">
                    <i class="fa fa-clock-o"></i> PENDING FINAL REVIEW
                </span>
                {{end}}
                {{ if eq .Reg.Approved 1 }}
                <span class="badge badge-success">
                    <i class="fa fa-clock-o"></i> APPROVED
                </span>
                {{end}}
                {{ if eq .Reg.Approved 2 }}
                <span class="badge badge-danger">
                    <i class="fa fa-clock-o"></i> REJECTED
                </span>
                {{end}}
            </div>
        </header>

        <div class="gridwrapper">

            <!-- Company Profile Section -->
            <div class="company-profile">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-building"></i></span>
                    <h3>Company Profile</h3>
                </div>

                <div class="fields-grid">
                    <div class="field-group full-width">
                        <span class="field-label">Legal Name</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.CompanyName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">VAT ID</span>
                        <span class="field-value highlight" style="font-family: monospace;">{{ .Reg.VatID }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Country</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.Country }}</span>
                    </div>
                    <div class="field-group full-width">
                        <span class="field-label">Street Address</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.StreetAddress }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">City</span>
                        <span class="field-value">{{ .Reg.City }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Postal Code</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.PostalCode }}</span>
                    </div>
                </div>
            </div>

            <!-- Person Registering Section -->
            <div class="person-registering">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-user"></i></span>
                    <h3>Person Registering</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.FirstName }} {{ .Reg.LastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.Email }}</span>
                    </div>
                </div>
            </div>

            <!-- Legal Representative Section -->
            <div class="legal-representative">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-gavel"></i></span>
                    <h3>Legal Representative</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.LRFirstName }} {{ .Reg.LRLastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.LREmail }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Nationality</span>
                        <span class="field-value">{{ .Reg.LRCountry }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">ID Card</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LRIdCard }}</span>
                    </div>
                </div>
            </div>

            <!-- Account Admin Section -->
            <div class="account-admin">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-user-secret"></i></span>
                    <h3>Account Admin (LEAR)</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.LEARFirstName }} {{ .Reg.LEARLastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.LEAREmail }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Nationality</span>
                        <span class="field-value">{{ .Reg.LEARCountry }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Mobile Number</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LEARMobileNumber }}</span>
                    </div>
                    <div class="field-group full-width">
                        <span class="field-label">Registered Address</span>
                        <span class="field-value">{{ .Reg.LEARAddress }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">ID Card</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LEARIdCard }}</span>
                    </div>
                </div>
            </div>

            <!-- Uploaded Documents Section -->
            <div class="uploaded-documents">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-folder-open"></i></span>
                    <h3>Uploaded Documents</h3>
                </div>
                <div class="docs-table-wrapper">
                    <table class="docs-table">
                        <thead>
                            <tr>
                                <th>Document Name</th>
                                <th>File Size</th>
                                <th>Status</th>
                                <th>Uploaded</th>
                                <th>Updated</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .Files }}

                            <tr>
                                <td>
                                    <div class="doc-name-cell">
                                        <i class="fa fa-file-pdf-o doc-icon"></i>
                                        <span>{{ .Name }}</span>
                                    </div>
                                </td>
                                <td>{{ .Size }} bytes</td>
                                {{ if eq .Status "uploaded" }}
                                <td><span class="badge badge-warning"><i class="fa fa-hourglass-half"></i> In
                                        Review</span></td>
                                {{ else if eq .Status "verified" }}
                                <td><span class="badge badge-success"><i class="fa fa-check-circle"></i> Verified</span>
                                </td>
                                {{ else if eq .Status "rejected" }}
                                <td><span class="badge badge-danger"><i class="fa fa-times-circle"></i> Rejected</span>
                                </td>
                                {{ end }}
                                <td>{{ .CreatedAt.Format "Jan 2, 2006" }}</td>
                                <td>{{ .UpdatedAt.Format "Jan 2, 2006" }}</td>
                                <td style="text-align: right;">
                                    <a href="/admin/api/file/{{ .FileID }}" class="action-btn-sm"
                                        title="View Document"><i class="fa fa-eye"></i>
                                        View</a>
                                </td>
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Process Status Section -->
            <div class="process-status">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-tasks"></i></span>
                    <h3>Process Status</h3>
                </div>

                <div class="status-timeline">
                    <!-- Stage 1 -->
                    <div class="status-stage">

                        <div class="stage-title">
                            <span>Stage 1: Self-Registration</span>
                        </div>

                        <div class="sub-tasks">

                            {{ if .Reg.Notified }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Customer Notification via email</span>
                                <span class="badge badge-success">Sent</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        Customer Notification via email</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                {{ if .UserWrite }}
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying Email Notification...')">
                                    <i class="fa fa-refresh"></i> Retry Email Notification
                                </button>
                                {{ end }}
                            </div>
                            {{ end }}

                            {{ if .Reg.Issued }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Credential Issuance</span>
                                <span class="badge badge-success">Issued</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        Credential Issuance</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                {{ if .UserWrite }}
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying Credential Issuance...')">
                                    <i class="fa fa-refresh"></i> Retry Credential Issuance
                                </button>
                                {{ end }}
                            </div>
                            {{ end }}

                            {{ if .Reg.TMFRegistered }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i> TM
                                    Forum Registration</span>
                                <span class="badge badge-success">Registered</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        TM Forum Registration</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                {{ if .UserWrite }}
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying TM Forum Registration...')">
                                    <i class="fa fa-refresh"></i> Retry TM Forum Registration
                                </button>
                                {{ end }}
                            </div>
                            {{ end }}

                        </div>

                    </div>

                    <!-- Stage 2 -->

                    {{ if .Reg.LEARCompleted }}
                    <div class="status-stage">
                        <div class="stage-title">
                            <span>Stage 2: Representatives Data</span>
                        </div>

                        <div class="sub-tasks">

                            {{ if .Reg.FilesUploaded }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Files
                                    uploaded by user</span>
                                <span class="badge badge-success">Uploaded</span>
                            </div>

                            {{ else }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-circle-o sub-task-icon"></i>
                                    Files not yet uploaded</span>
                                <span class="badge badge-secondary">Pending</span>
                            </div>
                            {{ end }}



                            {{ if .Reg.LRCompleted }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    LEARCredential sent to Account admin</span>
                                <span class="badge badge-success">Sent</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        LEARCredential to Account admin</span>
                                    <span class="badge badge-danger">Not sent</span>
                                </div>
                                {{ if $.UserWrite }}
                                <button class="btn-retry" type="button"
                                    onclick="alert('Sending LEARCredential to Account admin...')">
                                    <i class="fa fa-refresh"></i> Send LEARCredential to Account admin
                                </button>
                                {{ end }}
                            </div>
                            {{ end }}

                        </div>

                    </div>

                    {{ else }}

                    <div class="status-stage">
                        <div class="stage-title">
                            <span>Stage 2: Representatives Data</span>
                            <span class="badge">Not Started</span>
                        </div>
                    </div>

                    {{ end }}


                </div>

                <!-- Admin Decisions Panel -->
                {{ if .UserWrite }}
                <div class="admin-actions">
                    <span class="admin-action-title">Admin Approval Action</span>
                    <div class="btn-group-vertical">

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="approved">
                            <button class="btn-action btn-action-approve">
                                <i class="fa fa-check"></i> Approve Registration
                            </button>
                        </form>

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="rejected">
                            <button class="btn-action btn-action-reject">
                                <i class="fa fa-ban"></i> Reject Registration
                            </button>
                        </form>

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="pending">
                            <button class="btn-action btn-action-pending">
                                <i class="fa fa-undo"></i> Reset to Pending
                            </button>
                        </form>

                    </div>

                </div>
                {{ end }}

            </div>

            <!-- Registration Log Section -->
            <div class="log">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-terminal"></i></span>
                    <h3>Activity Log</h3>
                </div>
                <div class="log-list">
                    <!-- Chronological log messages -->

                    {{ range .Logs }}

                    <div class="log-entry info">
                        <span class="log-time">{{ .CreatedAt | date "2006-01-02" }}
                            {{ .CreatedAt | date "15:04" }}</span>

                        {{ if eq .Type "info" }}
                        <span class="log-badge info">info</span>
                        {{ else if eq .Type "warning" }}
                        <span class="log-badge warning">warning</span>
                        {{ else if eq .Type "error" }}
                        <span class="log-badge error">error</span>
                        {{ end }}


                        <span class="log-message">{{ .Message }}</span>
                    </div>

                    {{ end }}

                </div>
            </div>

        </div>

    </main>
</body>

</html>