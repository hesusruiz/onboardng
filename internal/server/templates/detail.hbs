<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Detail - Operational Dashboard</title>

    <!-- External stylesheet dependencies -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">

    <style>
        /* Core Design Tokens - Strict Compliance with DESIGN.md */
        :root {
            --bg-canvas: #F4F5F7;
            /* Light slate gray for backdrop */
            --bg-card: #FFFFFF;
            /* Pure crisp white container fill */
            --border-primary: #1A1A1A;
            /* Sharp, explicit outline for section definition */
            --border-secondary: #E2E8F0;
            /* Subtle separator lines */
            --text-main: #000000;
            /* Maximum contrast for operational readings */
            --text-muted: #5A6A85;
            /* Prevent visual noise over structural labels */

            /* High-Contrast Strict-Utility Status Colors */
            --success-text: #137333;
            --success-bg: #E6F4EA;
            --success-border: #137333;

            --warning-text: #B06000;
            --warning-bg: #FEF7E0;
            --warning-border: #B06000;

            --danger-text: #C5221F;
            --danger-bg: #FCE8E6;
            --danger-border: #C5221F;

            --info-text: #1A73E8;
            --info-bg: #E8F0FE;
            --info-border: #1A73E8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            line-height: 1.4;

        }

        main {
            padding: 16px;
            /* Spacing & Layout: Margin is 16px */
        }

        /* Top Navigation Header */
        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            /* Spacing & Layout: Gap is 16px */
            background: var(--bg-card);
            padding: 16px;
            /* Spacing & Layout: Inner padding is 16px */
            border-radius: 4px;
            /* Small rounded shapes */
            border: 1px solid var(--border-primary);
            /* Sharp high-contrast border */
        }

        .header-title-wrapper {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-main);
            text-decoration: underline;
            font-weight: 700;
            font-size: 13px;
        }

        .back-link:hover {
            color: var(--text-muted);
        }

        .dashboard-title {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .subtitle {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Main CSS Grid Layout - Spacing & Layout: Gap 16px */
        .gridwrapper {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: auto;
            gap: 16px;
            grid-template-areas:
                "company-profile company-profile process-status"
                "person-registering person-registering process-status"
                "legal-representative legal-representative process-status"
                "account-admin account-admin process-status"
                "uploaded-documents uploaded-documents process-status"
                "log log log";
        }

        /* Grid Areas Mapping */
        .company-profile {
            grid-area: company-profile;
        }

        .person-registering {
            grid-area: person-registering;
        }

        .legal-representative {
            grid-area: legal-representative;
        }

        .account-admin {
            grid-area: account-admin;
        }

        .uploaded-documents {
            grid-area: uploaded-documents;
        }

        .process-status {
            grid-area: process-status;
        }

        .log {
            grid-area: log;
        }

        /* Strict Utility Card Styling */
        .gridwrapper>div {
            background-color: var(--bg-card);
            border: 1px solid var(--border-primary);
            padding: 16px;
            /* Spacing & Layout: Inner Card Padding: 16px */
            border-radius: 4px;
            /* Small rounded shapes */
            box-shadow: none;
            /* Zero decorative elements, zero shadows */
            transition: none;
            /* Zero dynamic transition effects */
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Card Hover Effects: Disabled completely to ensure zero marketing and distraction-free utility */
        .gridwrapper>div:hover {
            transform: none;
            box-shadow: none;
            border-color: var(--border-primary);
        }

        /* Section Headings - Visible but clean and non-distracting */
        .section-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-secondary);
        }

        .section-header h3 {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-main);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .section-icon {
            font-size: 14px;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Information Value Fields */
        .fields-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px 16px;
        }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .field-group.full-width {
            grid-column: span 2;
        }

        .field-label {
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.05em;
        }

        /* Values must always be bold and prominent */
        .field-value {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-main);
            word-break: break-word;
        }

        .field-value.highlight {
            text-decoration: underline;
        }

        .field-value a {
            color: inherit;
            text-decoration: underline;
        }

        .field-value a:hover {
            color: var(--text-muted);
        }

        /* Strict-Utility Status Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            border-radius: 2px;
            /* Small rounded shapes */
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            width: fit-content;
        }

        .badge-success {
            background-color: var(--success-bg);
            color: var(--success-text);
            border: 1px solid var(--success-border);
        }

        .badge-warning {
            background-color: var(--warning-bg);
            color: var(--warning-text);
            border: 1px solid var(--warning-border);
        }

        .badge-danger {
            background-color: var(--danger-bg);
            color: var(--danger-text);
            border: 1px solid var(--danger-border);
        }

        .badge-info {
            background-color: var(--info-bg);
            color: var(--info-text);
            border: 1px solid var(--info-border);
        }

        /* Uploaded Documents Table */
        .docs-table-wrapper {
            overflow-x: auto;
            margin-top: 4px;
        }

        .docs-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 12px;
        }

        .docs-table th {
            padding: 8px 10px;
            font-weight: 700;
            color: var(--text-muted);
            border-bottom: 2px solid var(--border-primary);
            background-color: var(--bg-canvas);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .docs-table td {
            padding: 10px;
            border-bottom: 1px solid var(--border-secondary);
            color: var(--text-main);
            vertical-align: middle;
        }

        .docs-table tr:hover td {
            background-color: var(--bg-canvas);
        }

        .doc-name-cell {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
            color: var(--text-main);
        }

        .doc-icon {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* View Button - Strict Hover Effect only on interactive components */
        .action-btn-sm {
            padding: 4px 8px;
            border-radius: 2px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid var(--border-primary);
            background-color: var(--bg-card);
            color: var(--text-main);
            transition: background-color 0.1s ease, color 0.1s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .action-btn-sm:hover {
            background-color: var(--border-primary);
            color: var(--bg-card);
        }

        /* Process Status Timeline */
        .process-status {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .status-timeline {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .status-stage {
            position: relative;
            padding-bottom: 4px;
        }

        .status-stage.active {
            border-left-color: var(--border-primary);
        }

        .status-adfssstage::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 4px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--border-secondary);
            border: 2px solid var(--bg-card);
        }

        .status-stage.success::before {
            background-color: var(--success-text);
        }

        .status-stage.danger::before {
            background-color: var(--danger-text);
        }

        .status-stage.warning::before {
            background-color: var(--warning-text);
        }

        .stage-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sub-tasks {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 6px;
            background-color: var(--bg-canvas);
            padding: 8px;
            border-radius: 2px;
            border: 1px solid var(--border-secondary);
        }

        .sub-task {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
        }

        .sub-task-name {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-main);
            font-weight: 700;
        }

        .sub-task-icon {
            font-size: 12px;
        }

        .sub-task-icon.success {
            color: var(--success-text);
        }

        .sub-task-icon.danger {
            color: var(--danger-text);
        }

        /* Retry Action Button - strict utility */
        .btn-retry {
            padding: 4px 8px;
            font-size: 10px;
            background-color: var(--warning-bg);
            border: 1px solid var(--warning-border);
            color: var(--warning-text);
            border-radius: 2px;
            cursor: pointer;
            font-weight: 700;
            transition: background-color 0.1s ease, color 0.1s ease;
            margin-top: 4px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-transform: uppercase;
        }

        .btn-retry:hover {
            background-color: var(--warning-text);
            color: var(--bg-card);
        }

        /* Admin Decisions Panel */
        .admin-actions {
            border-top: 1px solid var(--border-primary);
            padding-top: 12px;
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .admin-action-title {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 2px;
        }

        .btn-group-vertical {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .btn-action {
            width: 100%;
            padding: 8px 12px;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-align: center;
            border: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            transition: background-color 0.1s ease, color 0.1s ease;
        }

        .btn-action-approve {
            background-color: var(--success-bg);
            color: var(--success-text);
            border-color: var(--success-border);
        }

        .btn-action-approve:hover {
            background-color: var(--success-text);
            color: var(--bg-card);
        }

        .btn-action-reject {
            background-color: var(--danger-bg);
            color: var(--danger-text);
            border-color: var(--danger-border);
        }

        .btn-action-reject:hover {
            background-color: var(--danger-text);
            color: var(--bg-card);
        }

        .btn-action-pending {
            background-color: var(--bg-card);
            color: var(--text-main);
            border-color: var(--border-primary);
        }

        .btn-action-pending:hover {
            background-color: var(--border-primary);
            color: var(--bg-card);
        }

        /* Activity Log Section */
        .log-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-height: 250px;
            overflow-y: auto;
            margin-top: 6px;
            padding-right: 4px;
        }

        .log-entry {
            display: flex;
            align-items: center;
            padding: 6px 10px;
            border-radius: 2px;
            border: 1px solid var(--border-secondary);
            border-left: 4px solid var(--border-secondary);
            font-size: 12px;
            gap: 10px;
            background-color: var(--bg-card);
        }

        .log-entry.info {
            border-left-color: var(--success-border);
        }

        .log-entry.warning {
            border-left-color: var(--warning-border);
        }

        .log-entry.error {
            border-left-color: var(--danger-border);
        }

        .log-time {
            font-family: monospace;
            color: var(--text-muted);
            font-size: 11px;
            white-space: nowrap;
            font-weight: 700;
        }

        .log-badge {
            font-size: 9px;
            font-weight: 700;
            padding: 1px 4px;
            border-radius: 2px;
            text-transform: uppercase;
        }

        .log-badge.info {
            background-color: var(--success-bg);
            color: var(--success-text);
            border: 1px solid var(--success-border);
        }

        .log-badge.warning {
            background-color: var(--warning-bg);
            color: var(--warning-text);
            border: 1px solid var(--warning-border);
        }

        .log-badge.error {
            background-color: var(--danger-bg);
            color: var(--danger-text);
            border: 1px solid var(--danger-border);
        }

        .log-message {
            color: var(--text-main);
            font-weight: 700;
        }

        /* Scrollbar customization */
        .log-list::-webkit-scrollbar {
            width: 4px;
        }

        .log-list::-webkit-scrollbar-track {
            background: var(--bg-canvas);
        }

        .log-list::-webkit-scrollbar-thumb {
            background: var(--text-muted);
            border-radius: 2px;
        }

        .log-list::-webkit-scrollbar-thumb:hover {
            background: var(--text-main);
        }


        /* Portal Header Styling matching header.jpg and dome-marketplace.eu */
        .portal-header {
            background-color: #0A122C;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            box-sizing: border-box;
            border-bottom: 1px solid #1E293B;
            width: 100%;
        }

        .portal-header-left {
            display: flex;
            align-items: center;
            flex: 1;
        }

        .portal-logo {
            height: 38px;
            display: block;
        }

        .portal-header-center {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
            text-align: center;
        }

        .portal-title {
            color: #FFFFFF;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.01em;
            text-transform: uppercase;
        }

        .portal-header-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            flex: 1;
        }

        .portal-btn {
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            padding: 8px 20px;
            border-radius: 6px;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-transform: none;
            box-sizing: border-box;
        }

        .portal-btn-outline {
            color: #FFFFFF;
            background-color: transparent;
            border: 2px solid #2A5C91;
        }

        .portal-btn-outline:hover {
            border-color: #357ABD;
            background-color: rgba(42, 92, 145, 0.15);
        }

        .portal-btn-solid {
            color: #FFFFFF;
            background-color: #2A5C91;
            border: 2px solid transparent;
        }

        .portal-btn-solid:hover {
            background-color: #357ABD;
        }



        /* Responsive Layout Overrides */
        @media (max-width: 1024px) {
            .gridwrapper {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "process-status"
                    "company-profile"
                    "person-registering"
                    "legal-representative"
                    "account-admin"
                    "uploaded-documents"
                    "log";
            }
        }
    </style>
</head>

<body>
    <!-- Portal Top Header -->
    <header class="portal-header">
        <div class="portal-header-left">
            <img src="https://dome-marketplace.eu/assets/logos/DOME_Logo_White_Name.svg" alt="DOME Logo"
                class="portal-logo">
        </div>
        <div class="portal-header-center">
            <span class="portal-title">Onboard Admin</span>
        </div>
        <div class="portal-header-right">
            <a href="/passkeys/api/logout" class="portal-btn portal-btn-solid">Logout</a>
        </div>
    </header>

    <main>

        <!-- Top Header Navigation -->
        <header class="dashboard-header">
            <div class="header-title-wrapper">
                <a href="/admin/index" class="back-link">
                    <i class="fa fa-arrow-left"></i> Back to Registrations
                </a>

                <h1 class="dashboard-title">Registration Details</h1>
                <p class="subtitle">ID: <span style="font-family: monospace; font-weight: 700;">{{ .Reg.RegistrationID
                        }}</span> &bull; Submitted
                    {{ .Reg.CreatedAt.Format "Jan 2, 2006" }}
                </p>
            </div>
            <div>
                {{ if eq .Reg.Approved 0 }}
                <span class="badge badge-warning">
                    <i class="fa fa-clock-o"></i> PENDING FINAL REVIEW
                </span>
                {{end}}
                {{ if eq .Reg.Approved 1 }}
                <span class="badge badge-success">
                    <i class="fa fa-clock-o"></i> APPROVED
                </span>
                {{end}}
                {{ if eq .Reg.Approved 2 }}
                <span class="badge badge-danger">
                    <i class="fa fa-clock-o"></i> REJECTED
                </span>
                {{end}}
            </div>
        </header>

        <div class="gridwrapper">

            <!-- Company Profile Section -->
            <div class="company-profile">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-building"></i></span>
                    <h3>Company Profile</h3>
                </div>

                <div class="fields-grid">
                    <div class="field-group full-width">
                        <span class="field-label">Legal Name</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.CompanyName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">VAT ID</span>
                        <span class="field-value highlight" style="font-family: monospace;">{{ .Reg.VatID }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Country</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.Country }}</span>
                    </div>
                    <div class="field-group full-width">
                        <span class="field-label">Street Address</span>
                        <span class="field-value" style="font-size: 15px;">{{ .Reg.StreetAddress }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">City</span>
                        <span class="field-value">{{ .Reg.City }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Postal Code</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.PostalCode }}</span>
                    </div>
                </div>
            </div>

            <!-- Person Registering Section -->
            <div class="person-registering">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-user"></i></span>
                    <h3>Person Registering</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.FirstName }} {{ .Reg.LastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.Email }}</span>
                    </div>
                </div>
            </div>

            <!-- Legal Representative Section -->
            <div class="legal-representative">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-gavel"></i></span>
                    <h3>Legal Representative</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.LRFirstName }} {{ .Reg.LRLastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.LREmail }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Nationality</span>
                        <span class="field-value">{{ .Reg.LRCountry }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">ID Card</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LRIdCard }}</span>
                    </div>
                </div>
            </div>

            <!-- Account Admin Section -->
            <div class="account-admin">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-user-secret"></i></span>
                    <h3>Account Admin (LEAR)</h3>
                </div>
                <div class="fields-grid">
                    <div class="field-group">
                        <span class="field-label">Full Name</span>
                        <span class="field-value">{{ .Reg.LEARFirstName }} {{ .Reg.LEARLastName }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Email Address</span>
                        <span class="field-value">{{ .Reg.LEAREmail }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Nationality</span>
                        <span class="field-value">{{ .Reg.LEARCountry }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">Mobile Number</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LEARMobileNumber }}</span>
                    </div>
                    <div class="field-group full-width">
                        <span class="field-label">Registered Address</span>
                        <span class="field-value">{{ .Reg.LEARAddress }}</span>
                    </div>
                    <div class="field-group">
                        <span class="field-label">ID Card</span>
                        <span class="field-value" style="font-family: monospace;">{{ .Reg.LEARIdCard }}</span>
                    </div>
                </div>
            </div>

            <!-- Uploaded Documents Section -->
            <div class="uploaded-documents">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-folder-open"></i></span>
                    <h3>Uploaded Documents</h3>
                </div>
                <div class="docs-table-wrapper">
                    <table class="docs-table">
                        <thead>
                            <tr>
                                <th>Document Name</th>
                                <th>File Size</th>
                                <th>Status</th>
                                <th>Uploaded</th>
                                <th>Updated</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .Files }}

                            <tr>
                                <td>
                                    <div class="doc-name-cell">
                                        <i class="fa fa-file-pdf-o doc-icon"></i>
                                        <span>{{ .Name }}</span>
                                    </div>
                                </td>
                                <td>{{ .Size }} bytes</td>
                                {{ if eq .Status "uploaded" }}
                                <td><span class="badge badge-warning"><i class="fa fa-hourglass-half"></i> In
                                        Review</span></td>
                                {{ else if eq .Status "verified" }}
                                <td><span class="badge badge-success"><i class="fa fa-check-circle"></i> Verified</span>
                                </td>
                                {{ else if eq .Status "rejected" }}
                                <td><span class="badge badge-danger"><i class="fa fa-times-circle"></i> Rejected</span>
                                </td>
                                {{ end }}
                                <td>{{ .CreatedAt.Format "Jan 2, 2006" }}</td>
                                <td>{{ .UpdatedAt.Format "Jan 2, 2006" }}</td>
                                <td style="text-align: right;">
                                    <a href="/admin/api/file/{{ .FileID }}" class="action-btn-sm"
                                        title="View Document"><i class="fa fa-eye"></i>
                                        View</a>
                                </td>
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Process Status Section -->
            <div class="process-status">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-tasks"></i></span>
                    <h3>Process Status</h3>
                </div>

                <div class="status-timeline">
                    <!-- Stage 1 -->
                    <div class="status-stage">

                        <div class="stage-title">
                            <span>Stage 1: Self-Registration</span>
                        </div>

                        <div class="sub-tasks">

                            {{ if .Reg.Notified }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Customer Notification via email</span>
                                <span class="badge badge-success">Sent</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        Customer Notification via email</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying Email Notification...')">
                                    <i class="fa fa-refresh"></i> Retry Email Notification
                                </button>
                            </div>
                            {{ end }}

                            {{ if .Reg.Issued }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Credential Issuance</span>
                                <span class="badge badge-success">Issued</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        Credential Issuance</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying Credential Issuance...')">
                                    <i class="fa fa-refresh"></i> Retry Credential Issuance
                                </button>
                            </div>
                            {{ end }}

                            {{ if .Reg.TMFRegistered }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i> TM
                                    Forum Registration</span>
                                <span class="badge badge-success">Registered</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        TM Forum Registration</span>
                                    <span class="badge badge-danger">Failed</span>
                                </div>
                                <button class="btn-retry" type="button"
                                    onclick="alert('Retrying TM Forum Registration...')">
                                    <i class="fa fa-refresh"></i> Retry TM Forum Registration
                                </button>
                            </div>
                            {{ end }}

                        </div>

                    </div>

                    <!-- Stage 2 -->

                    {{ if .Reg.LEARCompleted }}
                    <div class="status-stage">
                        <div class="stage-title">
                            <span>Stage 2: Representatives Data</span>
                        </div>

                        <div class="sub-tasks">

                            {{ if .Reg.FilesUploaded }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    Files
                                    uploaded by user</span>
                                <span class="badge badge-success">Uploaded</span>
                            </div>

                            {{ else }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-circle-o sub-task-icon"></i>
                                    Files not yet uploaded</span>
                                <span class="badge badge-secondary">Pending</span>
                            </div>
                            {{ end }}



                            {{ if .Reg.LRCompleted }}
                            <div class="sub-task">
                                <span class="sub-task-name"><i class="fa fa-check-circle sub-task-icon success"></i>
                                    LEARCredential sent to Account admin</span>
                                <span class="badge badge-success">Sent</span>
                            </div>
                            {{ else }}
                            <div class="sub-task" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <div
                                    style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="sub-task-name"><i class="fa fa-times-circle sub-task-icon danger"></i>
                                        LEARCredential to Account admin</span>
                                    <span class="badge badge-danger">Not sent</span>
                                </div>
                                <button class="btn-retry" type="button"
                                    onclick="alert('Sending LEARCredential to Account admin...')">
                                    <i class="fa fa-refresh"></i> Send LEARCredential to Account admin
                                </button>
                            </div>
                            {{ end }}

                        </div>

                    </div>

                    {{ else }}

                    <div class="status-stage">
                        <div class="stage-title">
                            <span>Stage 2: Representatives Data</span>
                            <span class="badge">Not Started</span>
                        </div>
                    </div>

                    {{ end }}


                </div>

                <!-- Admin Decisions Panel -->
                <div class="admin-actions">
                    <span class="admin-action-title">Admin Approval Action</span>
                    <div class="btn-group-vertical">

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="approved">
                            <button class="btn-action btn-action-approve">
                                <i class="fa fa-check"></i> Approve Registration
                            </button>
                        </form>

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="rejected">
                            <button class="btn-action btn-action-reject">
                                <i class="fa fa-ban"></i> Reject Registration
                            </button>
                        </form>

                        <form action="/admin/registration?vat_id={{ .Reg.VatID }}" method="post">
                            <input type="hidden" name="status" value="pending">
                            <button class="btn-action btn-action-pending">
                                <i class="fa fa-undo"></i> Reset to Pending
                            </button>
                        </form>

                    </div>

                </div>

            </div>

            <!-- Registration Log Section -->
            <div class="log">
                <div class="section-header">
                    <span class="section-icon"><i class="fa fa-terminal"></i></span>
                    <h3>Activity Log</h3>
                </div>
                <div class="log-list">
                    <!-- Chronological log messages -->

                    {{ range .Logs }}

                    <div class="log-entry info">
                        <span class="log-time">{{ .CreatedAt | date "2006-01-02" }}
                            {{ .CreatedAt | date "15:04" }}</span>

                        {{ if eq .Type "info" }}
                        <span class="log-badge info">info</span>
                        {{ else if eq .Type "warning" }}
                        <span class="log-badge warning">warning</span>
                        {{ else if eq .Type "error" }}
                        <span class="log-badge error">error</span>
                        {{ end }}


                        <span class="log-message">{{ .Message }}</span>
                    </div>

                    {{ end }}

                </div>
            </div>

        </div>

    </main>
</body>

</html>