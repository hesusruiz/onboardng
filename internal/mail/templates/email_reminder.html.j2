<div>

    <!-- Test Environment Warning -->
    {%if not Runtime.IsProduction%}
    <div style="color: #c53030; font-size: 14px; text-align: center;">
        <p>⚠️ Test Environment: {{Runtime}}</p>
        <p>In production, this message is hidden and standard procedures apply.</p>
    </div>
    {%endif%}

    <!-- Hero Header -->

    <h2>Welcome to DOME</h2>

    <!-- Main Body -->
    <div>

        <p>Hello, {{Reg.FirstName}} {{Reg.LastName}}!</p>
        <p>This is a reminder about your registration request to become a Provider in the <strong>DOME
                Marketplace</strong>.
            Please remember to perform the second step of the registration process so you can publish your products
            on our marketplace.</p>

        <!-- Registration ID Card -->
        <div
            style="background-color: #f8fafc; border: 1px solid #f1f5f9; border-radius: 8px; padding: 20px; margin-bottom: 32px;">
            <div
                style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 8px;">
                Your Registration ID</div>
            <div
                style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; font-size: 20px; font-weight: 700; color: #2563eb;">
                {{Reg.RegistrationID}}
            </div>
        </div>

        <p>Below is a summary of the data you submitted:</p>

        <!-- Summary Tables -->
        <h3 style="margin-top: 24px; font-size: 16px; font-weight: bold; color: #1e3a8a;">Company Information</h3>
        <table
            style="width: 100%; border-collapse: collapse; border: 1px solid #cccccc; font-size: 14px; margin-bottom: 24px;">
            <tr>
                <td style="width: 30%; border: 1px solid #cccccc; padding: 8px;">Email Address</td>
                <td style="width: 70%; border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.Email}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Company Name</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.CompanyName}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Country</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.Country}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">VAT ID</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.VatID}}</td>
            </tr>
        </table>

        {% if Reg.LEARCompleted %}
        <h3 style="margin-top: 24px; font-size: 16px; font-weight: bold; color: #1e3a8a;">Legal Representative</h3>
        <table
            style="width: 100%; border-collapse: collapse; border: 1px solid #cccccc; font-size: 14px; margin-bottom: 24px;">
            <tr>
                <td style="width: 30%; border: 1px solid #cccccc; padding: 8px;">First Name</td>
                <td style="width: 70%; border: 1px solid #cccccc; padding: 8px; font-weight: bold;">
                    {{Reg.LRFirstName}}
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Last Name</td>
                <td style="width: 70%; border: 1px solid #cccccc; padding: 8px; font-weight: bold;">
                    {{Reg.LRLastName}}
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Email Address</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LREmail}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Country</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LRCountry}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">ID Card</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LRIdCard}}</td>
            </tr>
        </table>

        <h3 style="margin-top: 24px; font-size: 16px; font-weight: bold; color: #1e3a8a;">Legal Entity Authorized
            Representative (LEAR)</h3>
        <table
            style="width: 100%; border-collapse: collapse; border: 1px solid #cccccc; font-size: 14px; margin-bottom: 24px;">
            <tr>
                <td style="width: 30%; border: 1px solid #cccccc; padding: 8px;">First Name</td>
                <td style="width: 70%; border: 1px solid #cccccc; padding: 8px; font-weight: bold;">
                    {{Reg.LEARFirstName}}
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Last Name</td>
                <td style="width: 70%; border: 1px solid #cccccc; padding: 8px; font-weight: bold;">
                    {{Reg.LEARLastName}}
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Email Address</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LEAREmail}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Country</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LEARCountry}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Address</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LEARAddress}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">ID Card</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LEARIdCard}}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #cccccc; padding: 8px;">Mobile Number</td>
                <td style="border: 1px solid #cccccc; padding: 8px; font-weight: bold;">{{Reg.LEARMobileNumber}}</td>
            </tr>
        </table>
        {% endif %}

        <!-- Support Section -->
        {% if OnboardTeamEmail %}
        <div style="margin-top: 40px; padding-top: 24px; border-top: 1px solid #f1f5f9; text-align: center;">
            <p style="font-size: 14px; color: #64748b; margin: 0;">If you have any questions or need immediate
                assistance, please contact our support team:</p>
            <a href="mailto:{{OnboardTeamEmail}}"
                style="display: inline-block; margin-top: 12px; padding: 10px 20px; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; color: #1e3a8a; text-decoration: none; font-size: 14px; font-weight: 600;">{{OnboardTeamEmail}}</a>
        </div>
        {% endif %}
    </div>
</div>

<!-- Footer -->
<div style="background-color: #f8fafc; padding: 32px 24px; text-align: center;">
    <div style="font-size: 12px; color: #94a3b8; margin-bottom: 8px;">&copy; 2024-2026 DOME Marketplace Project
    </div>
    <div style="font-size: 11px; color: #cbd5e1;">This is an automated message, please do not reply directly to this
        email.</div>
</div>
</div>